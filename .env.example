# Copy to .env and adjust. Every value has a safe default; the app runs with none set.

ENVIRONMENT=development
LOG_LEVEL=INFO
# JWT signing + admin endpoints (X-Admin-Key)
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Database / cache (docker-compose overrides these for its own services)
DATABASE_URL=postgresql+psycopg://parakh:parakh@localhost:5432/parakh
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=600

# Scraping
# Celery beat cadence (1-24)
SCRAPE_INTERVAL_HOURS=6
# scrapling | httpx | stealth | dynamic
SCRAPER_FETCHER=scrapling
# x 250 products per page per store
SCRAPER_MAX_PAGES=20
SCRAPER_REQUEST_DELAY=1.0

# Search
# or "hash" (no model download, lower quality)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# chroma | leann | memory
VECTOR_BACKEND=chroma
# use a Chroma server instead of a local folder
# CHROMA_HOST=localhost

# LLM (optional — without one the assistant uses rule-based agents)
# none | groq | openrouter | ollama | auto
LLM_PROVIDER=none
# e.g. openrouter,ollama
LLM_FALLBACK_PROVIDERS=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_FAST_MODEL=llama-3.1-8b-instant
# OLLAMA_BASE_URL=http://localhost:11434/v1
# `llmfit serve` picks the best local model for this machine
# LLMFIT_URL=http://localhost:8787

# Assistant memory
# db | mempalace
MEMORY_BACKEND=db
